    {
      "parameters": {
        "fieldToSplitOut": "clips",
        "options": {}
      },
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1340, 384],
      "id": "22b0b4d0-1917-4aa5-85b2-a9e3a3a2e043",
      "name": "Split Clips"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst valid = items.filter(item => {\n  const clip = item.json;\n  if (clip.status !== 'done') {\n    console.log(`Skipping \"${clip.title}\" — status: ${clip.status}`);\n    return false;\n  }\n  if (!clip.file_path) {\n    console.log(`Skipping \"${clip.title}\" — no file_path`);\n    return false;\n  }\n  return true;\n});\nif (valid.length === 0) throw new Error('All clips failed in FFmpeg step.');\nconsole.log(`${valid.length}/${items.length} clips passing to renderer`);\nreturn valid;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 384],
      "id": "f3a1b2c4-d5e6-7890-abcd-ef1234567890",
      "name": "Filter Valid Clips"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://renderer:8006/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"episode_id\": \"{{ $('Chalchitra Webhook').item.json.body.episode_id }}\",\n  \"clip_path\": \"{{ $json.file_path }}\",\n  \"title\": \"{{ $json.title }}\",\n  \"start_seconds\": {{ $json.start_seconds }},\n  \"end_seconds\": {{ $json.end_seconds }},\n  \"words\": {{ JSON.stringify($('Transcribe').item.json.words) }},\n  \"channel_name\": \"Chalchitra\",\n  \"cta_text\": \"Follow for more\"\n}",
        "options": { "timeout": 600000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1780, 384],
      "id": "e311ae4e-b641-461a-ac8a-d73e2abf6e80",
      "name": "Renderer",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = items.map(item => {\n  const d = item.json;\n  if (d.error || d.status === undefined) {\n    return { status: 'failed', error: d.error?.message || JSON.stringify(d) };\n  }\n  return {\n    status: d.status,\n    episode_id: d.episode_id,\n    original_clip: d.original_clip,\n    rendered_clip: d.rendered_clip,\n    steps: d.steps,\n    duration_seconds: d.duration_seconds\n  };\n});\nconst succeeded = results.filter(r => r.status === 'done');\nconst failed = results.filter(r => r.status !== 'done');\nconsole.log(`Done: ${succeeded.length} succeeded, ${failed.length} failed`);\nreturn [{ json: { summary: { total: results.length, succeeded: succeeded.length, failed: failed.length }, rendered_clips: succeeded, failed_clips: failed } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 384],
      "id": "ab28faa7-a41d-4a23-91c9-34ffb8cf95ed",
      "name": "Collect Results"
    }
