        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"episode_id\": \"{{ $('Chalchitra Webhook').item.json.body.episode_id }}\",\n  \"file_path\": \"{{ $('Chalchitra Webhook').item.json.body.file_path }}\",\n  \"clips\": {{ JSON.stringify($json.clips) }}\n}",
        "options": { "timeout": 300000 }
